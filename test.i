                case value_t::null:
                case value_t::object:
                {

                    parent[last_path] = val;
                    break;
                }

                case value_t::array:
                {
                    if (last_path == "-")
                    {

                        parent.push_back(val);
                    }
                    else
                    {
                        const auto idx = json_pointer::template array_index<basic_json_t>(last_path);
                        if (__builtin_expect (!!(idx > parent.size()), 0 ))
                        {

